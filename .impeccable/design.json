  "narrative": {
    "northStar": "The Model Inspection Bench",
    "overview": "The built interface translates the assigned microscopy workbench direction into a quiet digital inspection bench. Warm paper surfaces, muted green controls and a separate neutral model field keep the specimen legible. Preparation, inspection and preserved versions are visible as working tools rather than decorative laboratory imagery.\n\nThe system is compact and task oriented. Small sentence-case headings, plain Spanish labels, fine dividers and restrained rounding give the model more visual weight than the surrounding controls. The comparison view uses equal adjacent panes and linked camera movement, with a common clay mode for judging geometry. Color mode shows the actual model materials.\n\nThis is a record of the built client and the existing desktop/mobile screenshots, following a confirmed code-led build. The North Star names the implemented direction; it is not a newly approved brand identity. No approved comp, QUALITY BAR card or generated critique-reference exists, so this document makes no comp-fidelity claim. Daedalus remains an implementation name.",
    "keyCharacteristics": [
      "Warm light surfaces with a muted green action accent.",
      "A distinct neutral field for inspecting real geometry.",
      "Compact, sentence-case utility typography.",
      "Flat panels and fine structural dividers.",
      "Aligned original/refined comparison with preserved version selection."
    ],
    "rules": [
      {
        "name": "The Specimen Field Rule",
        "body": "Keep the model field distinct from the paper control surfaces so the object remains the primary visual evidence.",
        "section": "colors"
      },
      {
        "name": "The Task Label Rule",
        "body": "Use short, sentence-case labels that name the action, object or state; do not introduce slogans or ornamental eyebrows.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Keep persistent panels flat; use elevation when a temporary surface overlaps the work.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep the model field visually distinct from the control surfaces.",
      "**Do** use sentence-case Spanish labels and compact, visible field names.",
      "**Do** show version selection through fill, border and a semantic pressed state.",
      "**Do** compare original and refined geometry in aligned panes with linked orbit.",
      "**Do** retain visible keyboard focus and honor reduced motion.",
      "**Do** keep export units visible beside the entered dimension."
    ],
    "donts": [
      "**Don't** add decorative laboratory imagery to express the inspection-bench direction.",
      "**Don't** raise every persistent panel with a shadow.",
      "**Don't** use a refined model's visual prominence to imply it is automatically better or print-ready.",
      "**Don't** replace the original with a refined result or label a synthetic specimen as an actual result.",
      "**Don't** promote the current small metadata sizes or utility system font into a new display-type standard."
    ]
  }
}
